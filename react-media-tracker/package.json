{
  "name": "react-media-tracker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "-------------------- comment 1 --------------------": "Main scripts:",
    "android-dev": "npm run setup-env-android-dev && react-native run-android",
    "android-prod": "npm run setup-env-android-prod && react-native run-android --mode=release",
    "ios-dev": "npm run setup-env-ios-dev; react-native run-ios",
    "ios-dev-ipad": "npm run setup-env-ios-dev; react-native run-ios --simulator \"iPad (7th generation)\"",
    "ios-prod": "npm run setup-env-ios-prod; react-native run-ios --device --mode Release",
    "-------------------- comment 2 --------------------": "Util scripts:",
    "android-clean": "cd android && ./gradlew clean && cd ..",
    "ios-clean": "cd ios && xcodebuild clean && cd ..",
    "ios-pod": "cd ios; pod install --repo-update; cd ..",
    "reset": "react-native start --reset-cache",
    "-------------------- comment 3 --------------------": "Script components:",
    "setup-env-android-dev": "npm run echo-env-dev && npm run cp-firebase-android-dev",
    "setup-env-android-prod": "npm run echo-env-prod && npm run cp-firebase-android-prod",
    "setup-env-ios-dev": "npm run echo-env-dev; npm run cp-firebase-ios-dev",
    "setup-env-ios-prod": "npm run echo-env-prod; npm run cp-firebase-ios-prod",
    "cp-firebase-android-dev": "shx cp \"./app/config/files/config-dev/google-services.json\" \"./android/app/\"",
    "cp-firebase-android-prod": "shx cp \"./app/config/files/config-prod/google-services.json\" \"./android/app/\"",
    "cp-firebase-ios-dev": "shx cp \"./app/config/files/config-dev/GoogleService-Info.plist\" \"./ios/\"",
    "cp-firebase-ios-prod": "shx cp \"./app/config/files/config-prod/GoogleService-Info.plist\" \"./ios/\"",
    "echo-env-dev": "shx echo \"MEDIA_TRACKER_APP_ENV=dev\" > .env",
    "echo-env-prod": "shx echo \"MEDIA_TRACKER_APP_ENV=prod\" > .env"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-documents/picker": "10.1.2",
    "@react-native-firebase/app": "21.13.0",
    "@react-native-firebase/auth": "21.13.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.0",
    "@react-navigation/drawer": "7.3.8",
    "@react-navigation/native": "7.1.5",
    "@react-navigation/stack": "7.2.9",
    "@reduxjs/toolkit": "2.6.1",
    "axios": "1.8.4",
    "class-transformer": "0.5.1",
    "class-transformer-validator": "0.9.1",
    "class-validator": "0.14.1",
    "date-fns": "4.1.0",
    "formik": "2.4.6",
    "i18n-js": "4.5.1",
    "react": "19.0.0",
    "react-native": "0.78.2",
    "react-native-config": "1.5.5",
    "react-native-date-picker": "5.0.12",
    "react-native-flash-message": "0.4.2",
    "react-native-fs": "2.20.0",
    "react-native-gesture-handler": "2.25.0",
    "react-native-reanimated": "3.17.2",
    "react-native-safe-area-context": "5.3.0",
    "react-native-screens": "4.10.0",
    "react-redux": "9.2.0",
    "redux-saga": "1.3.0",
    "string-strip-html": "8.5.0",
    "yup": "1.6.1"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/plugin-proposal-decorators": "7.25.9",
    "@babel/preset-env": "7.25.3",
    "@babel/runtime": "7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.78.2",
    "@react-native/metro-config": "0.78.2",
    "@react-native/typescript-config": "0.78.2",
    "@types/jest": "29.5.13",
    "@types/react": "19.0.0",
    "@types/react-test-renderer": "19.0.0",
    "@types/redux": "3.6.31",
    "babel-jest": "29.7.0",
    "babel-plugin-module-resolver": "5.0.2",
    "jest": "29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "reflect-metadata": "0.2.2",
    "shx": "0.4.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
